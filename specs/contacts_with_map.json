{
  "schema": "ui_layout_spec",
  "version": "1",
  "meta": {
    "project": "ano-unikalnyy-mir",
    "block_ref": "contacts_with_map",
    "target_stack": "react_tailwind",
    "breakpoints": ["sm","md","lg","xl"],
    "tokens": {
      "container": "max-w-7xl mx-auto px-4 md:px-6",
      "colors": {
        "bg_grad_from": "#F7F9FB",
        "bg_grad_to": "#F1EDF8",
        "heading": "#2F3A46",
        "muted": "#6B7785",
        "card_bg": "#FFFFFF",
        "card_border": "rgba(99,123,139,0.16)",
        "shadow": "rgba(15,45,52,0.10)"
      },
      "radius": { "xl": "1.25rem", "2xl": "1.5rem" }
    }
  },
  "assets": [
    { "id": "contacts_ref", "type": "image/png", "source_name": "Section-7.png", "role": "visual_reference" }
  ],
  "layout": {
    "class": "relative overflow-hidden py-14 md:py-20 bg-gradient-to-r from-[color:var(--bg-grad-from,#F7F9FB)] to-[color:var(--bg-grad-to,#F1EDF8)]",
    "children": [
      { "id": "container", "class": "w-full {{meta.tokens.container}}" },
      {
        "id": "header",
        "class": "text-center max-w-3xl mx-auto",
        "children": [
          { "type": "heading", "as": "h2", "text": "Контакты", "class": "text-3xl md:text-4xl font-bold tracking-tight text-[color:var(--heading,#2F3A46)]" },
          { "type": "sub", "as": "p", "text": "Свяжитесь с нами для участия в проектах или получения дополнительной информации", "class": "mt-3 text-base md:text-lg text-[color:var(--muted,#6B7785)]" }
        ]
      },
      {
        "id": "grid",
        "class": "mt-10 md:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-7",
        "children": [
          { "type": "map_card", "class": "rounded-2xl border border-[color:var(--card-border,rgba(99,123,139,0.16))] bg-white/70 shadow-[0_24px_48px_-24px_var(--tw-shadow-color)] p-0 overflow-hidden", "style": { "--tw-shadow-color": "rgba(15,45,52,0.10)" } },
          { "type": "form_card", "class": "rounded-2xl border border-[color:var(--card-border,rgba(99,123,139,0.16))] bg-white/70 shadow-[0_24px_48px_-24px_var(--tw-shadow-color)] p-6 md:p-7", "style": { "--tw-shadow-color": "rgba(15,45,52,0.10)" } },
          { "type": "contacts_card", "class": "rounded-2xl border border-[color:var(--card-border,rgba(99,123,139,0.16))] bg-white/70 shadow p-6 md:p-7" },
          { "type": "docs_card", "class": "rounded-2xl border border-[color:var(--card-border,rgba(99,123,139,0.16))] bg-white/70 shadow p-4 md:p-5" }
        ]
      }
    ]
  },
  "content": {
    "type": "contacts",
    "map": {
      "provider": "yandex",
      "script_url": "https://api-maps.yandex.ru/2.1/?lang=ru_RU",
      "container_id": "yandex-map",
      "height_class": "h-[260px] md:h-[340px]",
      "center": [55.7558, 37.6173],
      "zoom": 10,
      "placemark": {
        "coords_strategy": "geocode_on_load",
        "query": "Москва, Россия",
        "hint": "АНО «Уникальный мир» — Центральный офис",
        "balloon": "Москва, Россия — Центральный офис"
      }
    },
    "form": {
      "title": "Отправить сообщение",
      "fields": [
        { "id": "name", "label": "Ваше имя", "type": "text", "required": true },
        { "id": "email", "label": "Ваш e‑mail", "type": "email", "required": true },
        { "id": "message", "label": "Сообщение", "type": "textarea", "required": false, "rows": 5 }
      ],
      "submit": { "label": "Отправить", "icon_right": "lucide:send" },
      "endpoint": { "method": "POST", "href": "/api/contact/submit" },
      "privacy_note": "Отправляя форму, вы соглашаетесь с обработкой персональных данных"
    },
    "contacts": {
      "location": { "title": "Москва, Россия", "subtitle": "Центральный офис" },
      "channels": [
        { "icon": "lucide:mail", "label": "Основная почта", "value": "info@wugamers.ru", "href": "mailto:info@wugamers.ru" },
        { "icon": "lucide:phone", "label": "Телефон", "value": "+7 (977) 104-00-00", "href": "tel:+79771040000" },
        { "icon": "lucide:life-buoy", "label": "Тех. поддержка", "value": "cio@wugamers.ru", "href": "mailto:cio@wugamers.ru" }
      ]
    },
    "documents": [
      { "title": "Презентация", "meta": "PDF", "href": "https://wugamers.ru/wp-content/uploads/2022/05/%D0%9F%D1%80%D0%B5%D0%B7%D0%B5%D0%BD%D1%82%D0%B0%D1%86%D0%B8%D1%8F_WUG2022.pdf" },
      { "title": "Presentation ENG", "meta": "PDF", "href": "https://wugamers.ru/wp-content/uploads/2021/04/WUG2021_ENGv1.pdf" },
      { "title": "Регламент турнира WUG2021", "meta": "PDF", "href": "https://wugamers.ru/wp-content/uploads/2021/04/WUG2021_%D0%A0%D0%B5%D0%B3%D0%BB%D0%B0%D0%BC%D0%B5%D0%BD%D1%82.pdf" }
    ],
    "links_row": {
      "promo_video": { "label": "Проморолик", "href": "https://www.youtube.com/channel/UCuM6pM5taq-a5oZg2SIYJUw" },
      "presentation": { "label": "Презентация (PDF)", "href": "https://wugamers.ru/wp-content/uploads/2022/05/%D0%9F%D1%80%D0%B5%D0%B7%D0%B5%D0%BD%D1%82%D0%B0%D1%86%D0%B8%D1%8F_WUG2022.pdf" },
      "anthem": { "label": "Гимн WUGAMERS", "href": "https://www.youtube.com/channel/UCuM6pM5taq-a5oZg2SIYJUw" },
      "telegram": { "label": "Telegram @wugamers", "href": "https://t.me/wugamers" }
    },
    "donate_endpoints": {
      "iomoney": "https://sobe.ru/na/Q2S2i066P0Q9",
      "yandex_donate": "https://donate.stream/wugamers_ru"
    },
    "socials": {
      "telegram": "https://t.me/wugamers",
      "rutube": "https://rutube.ru/channel/56489051/",
      "vk": "https://vk.com/wugamers?from=groups",
      "youtube": "https://www.youtube.com/channel/UCuM6pM5taq-a5oZg2SIYJUw",
      "discord": "https://discord.gg/7HSrmfu"
    },
    "bindings": {
      "project_manifest": "ano-unikalnyy-mir.manifest.json"
    }
  },
  "behavior": {
    "form_validation": {
      "rules": {
        "name": "required|min:2",
        "email": "required|email",
        "message": "max:3000"
      }
    },
    "map_loader": {
      "mount_fn": "window.initYMap = () => { const ymReady = window.ymaps && window.ymaps.ready ? window.ymaps.ready : null; if (!ymReady) return; ymaps.ready(() => { const map = new ymaps.Map('yandex-map', { center: [55.7558,37.6173], zoom: 10 }); ymaps.geocode('Москва, Россия').then(r => { const p = r.geoObjects.get(0); if (p) { map.geoObjects.add(new ymaps.Placemark(p.geometry.getCoordinates(), { balloonContent: 'Москва, Россия — Центральный офис' })); map.setCenter(p.geometry.getCoordinates(), 12); } }); }); };",
      "defer_script": true
    }
  },
  "accessibility": {
    "landmark": "section",
    "aria_labels": {
      "form": "Форма обратной связи",
      "map": "Карта расположения офиса"
    }
  },
  "quality_gates": [
    { "type": "a11y", "level": "AA" },
    { "type": "visual_review", "notes": "Сверить сетку и карточки с макетом; проверить загрузку Яндекс‑скрипта." }
  ],
  "output": {
    "format": "file_tree",
    "files": ["components/contacts-section.tsx", "pages/api/contact/submit.ts"]
  }
}
