{
  "schema": "ui_layout_spec",
  "version": "1",
  "meta": {
    "project": "ano-unikalnyy-mir",
    "block_ref": "events_upcoming",
    "target_stack": "react_tailwind",
    "breakpoints": ["sm","md","lg","xl"],
    "tokens": {
      "font_primary": "Inter, system-ui, sans-serif",
      "container": "max-w-7xl mx-auto px-4 md:px-6",
      "radius_lg": "1rem",
      "radius_full": "9999px",
      "colors": {
        "bg_grad_from": "#E4F5F9",
        "bg_grad_to": "#F1EDF8",
        "heading": "#2F3A46",
        "subheading": "rgba(47,58,70,0.65)",
        "card_bg": "#FFFFFF",
        "card_border": "rgba(99,123,139,0.16)",
        "card_shadow": "rgba(15,45,52,0.08)",
        "muted": "#6B7785",
        "accent_aqua": "#7BCDC5",
        "accent_purple": "#B597F6",
        "accent_green": "#9BE5C7"
      }
    }
  },
  "assets": [
    {
      "id": "events_png_ref",
      "type": "image/png",
      "source_name": "Section.png",
      "hash_sha1": "5811ac0942324e8773638ba4e68e8743a8fc9df4",
      "role": "visual_reference"
    }
  ],
  "layout": {
    "class": "relative overflow-hidden py-14 md:py-20 bg-gradient-to-r from-[color:var(--bg-grad-from,#E4F5F9)] to-[color:var(--bg-grad-to,#F1EDF8)]",
    "children": [
      {
        "id": "container",
        "class": "w-full {{meta.tokens.container}}"
      },
      {
        "id": "header",
        "class": "text-center max-w-3xl mx-auto",
        "children": [
          {
            "type": "heading",
            "as": "h2",
            "text": "Ближайшие мероприятия",
            "class": "text-3xl md:text-4xl font-bold tracking-tight text-[color:var(--heading,#2F3A46)]"
          },
          {
            "type": "subheading",
            "as": "p",
            "text": "Присоединяйтесь к нашим инклюзивным турнирам и мастер-классам",
            "class": "mt-3 text-base md:text-lg text-[color:var(--subheading,rgba(47,58,70,0.65))]"
          }
        ]
      },
      {
        "id": "grid",
        "class": "mt-10 md:mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"
      }
    ]
  },
  "content": {
    "type": "announcements",
    "cards": [
      {
        "id": "world-of-tanks-uav-2025-03-15",
        "accent": "aqua",
        "date": "2025-03-15",
        "date_display": { "day": "15", "month": "МАР", "year": "2025" },
        "status_badge": { "text": "Скоро", "tone": "neutral" },
        "title": "Мир танков и БПЛА-фиджитал",
        "description": "Инклюзивный турнир для начинающих игроков",
        "meta": [
          { "icon": "lucide:map-pin", "text": "Парк Победы" },
          { "icon": "lucide:badge-check", "text": "Регистрация открыта" }
        ],
        "cta": {
          "label": "Подробнее",
          "href": "/events/world-of-tanks-uav-2025-03-15",
          "icon_right": "lucide:arrow-right",
          "variant": "gradient",
          "class": "mt-6 inline-flex items-center justify-center gap-2 w-full rounded-full px-5 py-3 bg-gradient-to-r from-[color:var(--accent-aqua,#7BCDC5)] to-[#8DDCDA] text-[#0F2A2E] font-medium"
        }
      },
      {
        "id": "drone-racing-masterclass-2025-03-22",
        "accent": "purple",
        "date": "2025-03-22",
        "date_display": { "day": "22", "month": "МАР", "year": "2025" },
        "status_badge": { "text": "Скоро", "tone": "neutral" },
        "title": "Мастер-класс по дрон-рейсингу",
        "description": "Обучающая программа для всех желающих",
        "meta": [
          { "icon": "lucide:map-pin", "text": "Онлайн / Москва" },
          { "icon": "lucide:users", "text": "30+ участников" }
        ],
        "cta": {
          "label": "Подробнее",
          "href": "/events/drone-racing-masterclass-2025-03-22",
          "icon_right": "lucide:arrow-right",
          "variant": "solid",
          "class": "mt-6 inline-flex items-center justify-center gap-2 w-full rounded-full px-5 py-3 bg-[#B597F6] text-white font-medium"
        }
      },
      {
        "id": "classic-football-cup-2025-04-05",
        "accent": "green",
        "date": "2025-04-05",
        "date_display": { "day": "05", "month": "АПР", "year": "2025" },
        "status_badge": { "text": "Скоро", "tone": "neutral" },
        "title": "Турнир по классическому футболу",
        "description": "Международные соревнования",
        "meta": [
          { "icon": "lucide:map-pin", "text": "СПбГУ" },
          { "icon": "lucide:globe-2", "text": "15 стран" }
        ],
        "cta": {
          "label": "Подробнее",
          "href": "/events/classic-football-cup-2025-04-05",
          "icon_right": "lucide:arrow-right",
          "variant": "solid",
          "class": "mt-6 inline-flex items-center justify-center gap-2 w-full rounded-full px-5 py-3 bg-[color:var(--accent-green,#9BE5C7)] text-[#0F2A2E] font-medium"
        }
      }
    ],
    "card_component": {
      "class": "group bg-[color:var(--card-bg,#FFFFFF)] rounded-2xl p-6 md:p-7 border border-[color:var(--card-border,rgba(99,123,139,0.16))] shadow-[0_10px_24px_-12px_var(--tw-shadow-color)] hover:shadow-[0_18px_38px_-16px_var(--tw-shadow-color)] transition-all",
      "style": { "--tw-shadow-color": "rgba(15,45,52,0.08)" },
      "parts": {
        "date_box": "inline-flex flex-col items-center justify-center w-[94px] h-[94px] rounded-2xl border-2",
        "date_day": "text-2xl font-semibold",
        "date_month": "text-sm tracking-widest uppercase",
        "date_year": "text-xs text-[color:var(--muted,#6B7785)]",
        "status_chip": "ml-3 align-middle rounded-full px-3 py-1 text-xs font-medium bg-[rgba(99,123,139,0.08)] text-[color:var(--muted,#6B7785)]",
        "title": "mt-5 text-xl md:text-2xl font-semibold text-[color:var(--heading,#2F3A46)]",
        "desc": "mt-2 text-[15px] leading-6 text-[color:var(--muted,#6B7785)]",
        "meta_list": "mt-4 space-y-1 text-[15px] text-[color:var(--muted,#6B7785)]"
      },
      "accent_map": {
        "aqua": {
          "date_border": "border-[color:var(--accent-aqua,#7BCDC5)]",
          "date_text": "text-[color:var(--accent-aqua,#7BCDC5)]",
          "cta_variant": "gradient"
        },
        "purple": {
          "date_border": "border-[#B597F6]",
          "date_text": "text-[#B597F6]",
          "cta_variant": "solid"
        },
        "green": {
          "date_border": "border-[color:var(--accent-green,#9BE5C7)]",
          "date_text": "text-[color:var(--accent-green,#9BE5C7)]",
          "cta_variant": "solid"
        }
      }
    },
    "bindings": {
      "project_manifest": "ano-unikalnyy-mir.manifest.json",
      "data_source": {
        "kind": "file",
        "path": "/data/events.json",
        "schema": "events[]: {id, title, date, location, description, status, stats, accent, links{details, apply}}"
      }
    },
    "section_cta_optional": {
      "display": false,
      "label": "Оставить заявку",
      "action": "open_telegram_bot",
      "href": "https://t.me/wugamers"
    }
  },
  "behavior": {
    "date_locale": "ru-RU",
    "labels": { "soon": "Скоро" },
    "rules": [
      "Если date - сегодня+1..30 дней → показывать бейдж 'Скоро'",
      "Если meta содержит 'Регистрация открыта' → подсветить эту строку классом 'text-[color:#2F3A46]' font-medium"
    ],
    "animations": [
      "card:hover → translate-y-[2px]",
      "cta:hover → opacity-95"
    ]
  },
  "accessibility": {
    "landmark": "section",
    "aria_labels": {
      "section": "Ближайшие мероприятия",
      "cards_list": "Список ближайших мероприятий",
      "cta_more": "Подробнее о мероприятии"
    },
    "roles": {
      "cards_container": "list",
      "card": "listitem"
    },
    "keyboard": {
      "card_focus": "ring-2 ring-offset-2 ring-[rgba(123,205,197,0.6)] rounded-2xl"
    }
  },
  "responsiveness": [
    { "bp": "sm", "rules": ["grid-cols-1", "date_box:w-[88px] h-[88px]", "title:text-[20px]"] },
    { "bp": "md", "rules": ["grid-cols-2"] },
    { "bp": "lg", "rules": ["grid-cols-3"] }
  ],
  "component_mapping": {
    "card": { "library": "shadcn", "component": "Card" },
    "badge": { "library": "shadcn", "component": "Badge" },
    "button": { "library": "shadcn", "component": "Button" }
  },
  "quality_gates": [
    { "type": "screenshot_diff", "reference_asset": "events_png_ref", "threshold": 0.98 },
    { "type": "a11y", "level": "AA" }
  ],
  "mcp_preferences": {
    "use": ["context7","sequential-thinking"],
    "context7": { "libraries": ["/tailwindcss/tailwindcss","/radix-ui/react"] },
    "sequential-thinking": { "plan": ["сетка","карточки","акценты","формат даты RU","адаптив","a11y","пиксель‑сверка"] }
  },
  "output": {
    "format": "file_tree",
    "files": ["components/events-section.tsx","data/events.json","styles/globals.css"]
  }
}
